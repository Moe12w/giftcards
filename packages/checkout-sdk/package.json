{
  "name": "@tazella/checkout-sdk",
  "version": "0.1.0",
  "description": "Framework-agnostic gift-card payment method for external checkout apps. No secrets, no balance decisions.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.ts"
  },
  "files": [
    "src",
    "examples",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "gift-card",
    "checkout",
    "payments",
    "tazella"
  ]
}
