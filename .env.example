# App (public) — safe to expose in the client bundle.
# Copy this file to .env and fill in your Supabase project values.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
EXPO_PUBLIC_APP_SCHEME=giftly

# ---------------------------------------------------------------------------
# SECRETS — do NOT put these in .env or any file Git can see.
# Set them in Supabase Dashboard > Edge Functions > Secrets, or with:
#   supabase secrets set NAME=value
# ---------------------------------------------------------------------------
# MYFATOORAH_API_KEY=
# MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com
# MYFATOORAH_WEBHOOK_SECRET=
# APP_PUBLIC_URL=https://your-app.example.com
# SUPABASE_SERVICE_ROLE_KEY=   (provided automatically to Edge Functions)
# APPLE_PASS_CERT_PEM=
# APPLE_PASS_KEY_PEM=
# APPLE_PASS_PASSWORD=
# APPLE_WWDR_CERT_PEM=
# APPLE_PASS_TYPE_ID=
# APPLE_TEAM_ID=
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# Enterprise code encryption (server side only).
# Stored in system_settings, never in the app.
# ---------------------------------------------------------------------------
# ENTERPRISE_CODE_ENCRYPTION_KEY=   (a long random string)

# ---------------------------------------------------------------------------
# Local tooling only — database password for `supabase link` / `db push`.
# This file is git-ignored. Never commit it.
# ---------------------------------------------------------------------------
# SUPABASE_DB_PASSWORD=
# SUPABASE_PROJECT_REF=
# SUPABASE_ACCESS_TOKEN=   (from supabase.com/dashboard/account/tokens)

# ---------------------------------------------------------------------------
# Bulk gift cards for business accounts.
#
# RESEND_API_KEY turns on automatic email delivery of gift card links when a
# business buys in bulk. Without it the links are queued in the outbox and the
# business can still download them as CSV and send them itself.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=
# EMAIL_FROM=Giftly <gifts@giftly.qa>
