# App (public) — safe to expose in the client bundle.
# Copy this file to .env and fill in your Supabase project values.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
EXPO_PUBLIC_APP_SCHEME=tazella

# The public web app, used for claim links sent to recipients who may not have
# the app (for example in a WhatsApp message). Falls back to a tazella:// deep
# link when it is not set.
EXPO_PUBLIC_SITE_URL=https://YOUR-SITE.vercel.app

# ---------------------------------------------------------------------------
# SECRETS — do NOT put these in .env or any file Git can see.
# Set them in Supabase Dashboard > Edge Functions > Secrets, or with:
#   supabase secrets set NAME=value
# ---------------------------------------------------------------------------
# MyFatoorah — advertising checkout in web/ pays by card through it.
# MYFATOORAH_API_KEY=            (portal: Integration Settings -> API Key)
# MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com   (test) / Qatar live URL from the docs
# MYFATOORAH_WEBHOOK_SECRET=     (portal webhook "secure key"; the webhook route fails closed without it)
# APP_PUBLIC_URL=https://your-app.example.com           (builds the callback + webhook URLs)
#
# MyFatoorah webhook URL to register in the portal:
#   https://your-app.example.com/api/advertising/myfatoorah/webhook
# Browser return URL is passed per invoice; nothing to register for it.
# Wallet passes — `supabase/functions/wallet-pass` builds them. Until these are
# set the app shows "wallet passes are not available yet" and nothing breaks.
#
# WALLET_PASS_TOKEN_SECRET=   (a long random string; signs each pass's web
#                             service token. Rotating it invalidates old pass links.)
# WALLET_PUBLIC_BASE_URL=     (optional; overrides the public base the pass web
#                             service is reached at, e.g. a custom domain in front
#                             of the Supabase functions URL)
#
# Apple: a Pass Type ID and its certificate, exported as PEM with the key, plus
# the Apple WWDR intermediate. Convert the .p12 first:
#   openssl pkcs12 -in pass.p12 -clcerts -nokeys -out cert.pem
#   openssl pkcs12 -in pass.p12 -nocerts -nodes -out key.pem
# APPLE_PASS_TYPE_ID=pass.qa.tazella.card
# APPLE_TEAM_ID=
# APPLE_PASS_CERT_PEM=
# APPLE_PASS_KEY_PEM=
# APPLE_PASS_PASSWORD=        (only if key.pem is still encrypted)
# APPLE_WWDR_CERT_PEM=
#
# Google: issuer ID from the Google Wallet Business Console, and the service
# account key JSON (raw or base64) with wallet_object.issuer access.
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# Enterprise code encryption (server side only).
# Stored in system_settings, never in the app.
# ---------------------------------------------------------------------------
# ENTERPRISE_CODE_ENCRYPTION_KEY=   (a long random string)

# ---------------------------------------------------------------------------
# Scheduled work (optional but recommended).
#
# `/api/cron` delivers gifts whose scheduled date has passed and runs the
# advertising lifecycle. Vercel Cron calls it once a day, just after midnight UTC
# (see web/vercel.json), and sends this value as a bearer token automatically.
# Any other scheduler can call the same URL with `Authorization: Bearer
# $CRON_SECRET` or `x-cron-secret`. Without it the route answers 503 and nothing
# runs on a schedule.
# ---------------------------------------------------------------------------
# CRON_SECRET=   (a long random string)

# ---------------------------------------------------------------------------
# Local tooling only — database password for `supabase link` / `db push`.
# This file is git-ignored. Never commit it.
# ---------------------------------------------------------------------------
# SUPABASE_DB_PASSWORD=
# SUPABASE_PROJECT_REF=
# SUPABASE_ACCESS_TOKEN=   (from supabase.com/dashboard/account/tokens)

# ---------------------------------------------------------------------------
# Email delivery (optional).
#
# The normal place for this is the dashboard: Admin -> Settings -> Email
# delivery. A key saved there is used straight away, with no redeploy.
#
# These variables are only a fallback for deployments that prefer environment
# configuration. Without a key nothing is emailed: bulk gift links are queued in
# the outbox and the business can still download them as CSV and send them.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=
# EMAIL_FROM=Tazella <gifts@tazella.com.qa>
